# D&D DM Assistant Environment Configuration

# OpenAI API (required)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Neo4j Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# RAG Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5

# Who may read the graph. EMPTY MEANS OPEN, which is what local development
# wants -- and is the one setting to check twice on a deployment, because the
# graph holds the prose of two published books. One entry per person, hashed:
#
#   uv run python -m backend.scripts.mint_token sam
#
# prints the token to hand over and the line to paste here. See docs/deploying.md.
ACCESS_TOKENS=

# Origins the browser may call from, comma-separated. Empty means any, which is
# right locally; a deployment sets its one Vercel URL.
ALLOWED_ORIGINS=
